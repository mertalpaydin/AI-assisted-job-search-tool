# Job Search Configuration

search:
  # Search terms. Each entry is {term, tier, max_pages}; a bare string also works
  # and defaults to tier 1 with the global max_pages below.
  #   tier 1 = searched every cycle, tier 2 = every 2nd cycle, tier 3 = every 3rd.
  #   max_pages overrides the global max_pages for that term only.
  keywords:
    - {term: "Machine Learning Engineer", tier: 1, max_pages: 10}
    - {term: "Data Engineer",             tier: 2, max_pages: 5}
    - "Python Developer"          # bare string = tier 1, global max_pages
    - "Backend Engineer"

  locations:
    - geo_id: "106150090"
      name: "Frankfurt am Main"
    - geo_id: "101282230"
      name: "Germany"

  title_filter:
    # At least one of these must appear in the title, or the job is prefiltered.
    require_any:
      - "ai"
      - "data"
      - "engineer"

    # Hard exclusions, checked before the detail fetch. Matching jobs are stored
    # with a prefilter_reason instead of being fetched or screened.
    exclude_any:
      - "werkstudent"
      - "internship"
      - "c++"

    # Rejected only when the title carries no AI/data signal, so
    # "Full-Stack AI Engineer" survives while "Full Stack Engineer" does not.
    exclude_unless_ai:
      - "full stack"
      - "backend"

  # Deterministic checks after the detail fetch, before the screening call.
  prefilter:
    enabled: true
    allowed_employment_status: ["Full-time"]
    excluded_experience_levels: ["Internship"]
    reject_fluent_german: true

  rate_limits:
    requests_per_minute: 30
    delay_between_requests: 2
    max_retries: 3
  max_pages: 5  # up to 500 results per keyword+location (100 per page)

# Companies to block entirely — jobs from these are skipped during scraping
  # and hidden in the web UI. Matching is case-insensitive.
