# Job Search Configuration

search:
  # Search terms. Each entry is {term, tier, max_pages}; a bare string also works
  # and defaults to tier 1 with the global max_pages below.
  #   tier 1 = searched every cycle, tier 2 = every 2nd cycle, tier 3 = every 3rd.
  #   max_pages overrides the global max_pages for that term only.
  keywords:
    - {term: "Machine Learning Engineer", tier: 1, max_pages: 10}
    - {term: "Data Engineer",             tier: 2, max_pages: 5}
    - "Python Developer"          # bare string = tier 1, global max_pages
    - "Backend Engineer"

  locations:
    - geo_id: "106150090"
      name: "Frankfurt am Main"
    - geo_id: "101282230"
      name: "Germany"

  # Long lists (title keywords + blocked companies) live in a separate file.
  # Copy config/filters.yaml.example to config/filters.yaml and edit it there.
  filters_file: "filters.yaml"

  # Deterministic checks after the detail fetch, before the screening call.
  prefilter:
    enabled: true
    allowed_employment_status: ["Full-time"]
    excluded_experience_levels: ["Internship"]
    reject_fluent_german: true

  rate_limits:
    requests_per_minute: 30
    delay_between_requests: 2
    max_retries: 3
  max_pages: 5  # up to 500 results per keyword+location (100 per page)

# AI Screening
screening:
  model:
    path: "data/models/gemma-4-E4B-it-UD-Q4_K_XL.gguf"  # Path to local GGUF file
    n_gpu_layers: -1        # -1 = offload all layers to GPU
    n_ctx: 4096             # Context window
    max_new_tokens: 512
    temperature: 0.1        # Low temp for deterministic JSON output
  criteria:
    min_cv_match_score: 0.65
    max_german_level: "low"   # none | low | medium | high
    preferred_locations:
      - "Frankfurt"
      - "Remote"

# Cover Letter Generation
cover_letter:
  model: "gemini-3-flash-preview"
  temperature: 0.7
  max_tokens: 1000
  rate_limits:
    requests_per_minute: 15
    retry_delay: 60
    max_retries: 5

# Concurrency
concurrency:
  max_search_workers: 2
  max_details_workers: 3
  max_screening_workers: 1
  max_cover_letter_workers: 3

# Execution
# Verified database snapshots.
#
# Snapshots are taken with SQLite's VACUUM INTO (a consistent image in well
# under a second), verified with quick_check before being kept, and verified
# again before a restore. An unverified backup is not a backup: it is possible
# to hold several copies of a database and have all of them be the corruption.
#
# They are taken at the end of each pipeline run, before bulk or destructive
# commands (purge-blocked, clean, backfill-sizes), and — because the web UI is
# where application decisions, notes and approvals are made — once you stop
# clicking in it. Reads never trigger one.
#
# Every database open also runs quick_check first (database.check_integrity_on_open),
# because opening runs migrations, so an unchecked open writes into a damaged file.
#
#   backup:
#     enabled: true
#     dir: "data/backups"
#     keep: 3                  # verified, so 3 is plenty; the tiers give it reach
#     tier_hours: [0, 12, 168] # newest, ~12h old, ~1 week old
#     offsite_path: ""         # e.g. a synced folder: version history off this machine
#     idle_seconds: 120        # snapshot this long after the last web UI edit
#     max_interval_seconds: 1800   # ...and at least this often during a long session
#
# Restore with:  uv run job-search backup --list
#                uv run job-search restore latest

execution:
  max_runtime_hours: 8
  shutdown_conditions:
    no_new_jobs_minutes: 30
    check_interval_seconds: 60
  pickup_on_restart: true
  checkpoint_interval_minutes: 5

# Screening mode. Batch costs half as much and does not need the laptop awake,
# at the price of up to 24h latency. "auto" keeps the daily delta instant and
# switches to batch for a backlog, which is usually what you want.
#   screening:
#     mode: "auto"              # instant | batch | auto
#     batch_threshold: 2000     # manual runs only: backlog size that forces batch
#     batch_stale_after_hours: 36
#
# Under "auto":
#   scheduled run  -> batch    (nobody waiting, 24h latency is free, 50% cheaper)
#   manual run     -> instant  (you are watching), unless the backlog exceeds
#                              batch_threshold, which you would not sit through

# LinkedIn session persistence. The stored session removes the need for a 2FA
# approval on every run, which is what makes scheduling possible.
auth:
  session_file: "data/linkedin_session.json"
  interactive_timeout: 300      # seconds to wait for a phone approval at login
  validate_on_start: true       # one cheap request to confirm the session lives

# Scheduled-run suppression. Pausing writes a sentinel with an absolute resume
# time; the next scheduled run after that moment clears it automatically.
schedule:
  pause_file: "data/schedule.paused"
  default_pause: "tomorrow_morning"   # 12h | tomorrow_morning | 24h | indefinite
  morning_resume_hour: 7

# Database
database:
  path: "data/jobs.db"

# Logging
logging:
  level: "INFO"
  file: "logs/job_search.log"

# Web UI (starts automatically with the pipeline, also available via: job-search web)
web:
  auto_start: true
  host: "127.0.0.1"
  port: 5000

# Export (cover letters written here automatically as each one is generated)
export:
  output_dir: "data/export"
